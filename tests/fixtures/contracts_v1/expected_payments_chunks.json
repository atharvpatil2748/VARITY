 {
  "kind": "requirement",
  "text": "Refund window\nRefund requests MUST be accepted only within 30 days.\nConstraints:\n- A later request MUST return REFUND_WINDOW_EXPIRED.\nEdge cases:\n- A request at exactly 30 days is accepted.",
  "block_start": 1,
  "block_end": 9,
  "start_offset": null,
  "end_offset": null,
  "requirement_id": null
 },
 {
  "kind": "requirement",
  "text": "Partial refund\nThe API MUST support partial refunds.",
  "block_start": 10,
  "block_end": 13,
  "start_offset": null,
  "end_offset": null,
  "requirement_id": null
 },
 {
  "kind": "requirement",
  "text": "Idempotent refunds\nRetrying a refund with the same idempotency_key MUST return the original result.",
  "block_start": 14,
  "block_end": 15,
  "start_offset": null,
  "end_offset": null,
  "requirement_id": null
 },
 {
  "kind": "general_chunk",
