  "block_end": 16,
  "start_offset": null,
  "end_offset": null,
  "requirement_id": null
 },
 {
  "kind": "api_definition",
  "text": "POST /refunds\nRequest fields are payment_id, amount and idempotency_key.",
  "block_start": 17,
  "block_end": 18,
  "start_offset": null,
  "end_offset": null,
  "requirement_id": null
 },
 {
